# 複製成 .env 再填。.env 已在 .gitignore 裡。

# ── LINE Messaging API ───────────────────────────────────────────────────────
# LINE Developers Console → 你的 channel → Messaging API 頁籤。
# **記得同時開啟「Allow bot to join group chats」**，預設是關的，
# 沒開的話 bot 加不進群組，也收不到任何群組訊息。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── L1 擷取 ──────────────────────────────────────────────────────────────────
# 總開關。關著時整條路徑不建 DB、不寫任何東西，是安全的預設。
LINE_CAPTURE_ENABLED=false

# 群組對應表（同時是白名單）。**沒列進去的群組一律不錄**——這是刻意的預設拒絕，
# 否則 bot 會把它所在的每一個對話都錄下來，包括 1:1 私訊。
# 格式見 groups.example.csv。
LINE_CAPTURE_GROUPS_CSV=groups.csv

# 探索模式：對「不在白名單」的群組，log 一行 group ID（**不記任何內容**）。
# LINE 沒有任何 API 能列出 bot 所在的群組，從實際進來的事件裡看是唯一辦法。
# 預設開啟，因為關著的代價是「群組加了、訊息也確實收到了，卻撈不到 ID」。
LINE_CAPTURE_DISCOVER=true

# 媒體（照片／PDF／語音）要不要下載。第一次上線建議先設 false 只跑文字，
# 確認落地正常再開。注意 LINE 的媒體內容有保存期限，不即時抓就抓不到了。
LINE_CAPTURE_MEDIA_ENABLED=true
LINE_CAPTURE_MEDIA_MAX_BYTES=20971520

# 資料落點。data/ 已在 .gitignore 裡。
LINE_CAPTURE_DB_PATH=data/line_capture.db
LINE_CAPTURE_MEDIA_DIR=data/line_capture_media

# 擷取層的 SQLite timeout（秒）。**刻意設短**：如果你把擷取掛在一個既有的
# webhook 服務上，擷取塞住不能拖垮本來就在跑的業務——寧可掉擷取的資料。
LINE_CAPTURE_DB_TIMEOUT=2.0

# ── L2 萃取 ──────────────────────────────────────────────────────────────────
# 走本機的 Claude Code CLI（吃訂閱額度），不打計費 API。
# 留空會自動找 PATH 上的 claude.cmd / claude。
LINE_EXTRACT_CLAUDE_COMMAND=
LINE_EXTRACT_TIMEOUT_SEC=180

# ── L3 審核 ──────────────────────────────────────────────────────────────────
# 產出目錄（候選與審核表 JSON 都寫這裡）
PIPELINE_DATA_DIR=data

# 你的專案樹。兩棵樹都有的名字才算一個有效專案——只問「資料夾存在嗎」會讓
# 報表、範本之類真實存在的目錄一起混進下拉選單。
PROJECT_FILES_ROOT=
PROJECT_INDEX_ROOT=

# 歸檔目的地的相對樣板，支援 {trade} 與 {vendor}
ARCHIVE_SUBPATH=vendors/{trade}/{vendor}

# 審核伺服器。**預設綁 127.0.0.1，這支沒有登入機制**——
# 要對外開放前請自己加認證，或放在有認證的反向代理後面。
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8770
REVIEW_ALLOWED_ROOTS=
REVIEW_QUEUE_PATH=data/review_queue.jsonl
